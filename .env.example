# Copy to .env for local runs of tools/backfill.js. Never commit .env.
# In GitHub Actions these come from repository secrets.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
# AI coach: the first key set wins: BEDROCK_API_KEY, ANTHROPIC_API_KEY, OPENROUTER_API_KEY.
BEDROCK_API_KEY=
# Optional, defaults to au.anthropic.claude-sonnet-4-6 (ap-southeast-2)
BEDROCK_MODEL=
BEDROCK_MESSAGES_URL=
ANTHROPIC_API_KEY=
# Optional, defaults to claude-haiku-5-5
ANTHROPIC_MODEL=
OPENROUTER_API_KEY=
# Optional; defaults to anthropic/claude-haiku-5.5
OPENROUTER_MODEL=
